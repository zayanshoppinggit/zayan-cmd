{
  "name": "BusinessSettings",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Business name"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email"
    },
    "phone_number": {
      "type": "string",
      "description": "Phone number"
    },
    "website": {
      "type": "string",
      "description": "Website URL"
    },
    "address": {
      "type": "string",
      "description": "Business address"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true
    },
    "new_service_alerts": {
      "type": "boolean",
      "default": true
    },
    "status_change_alerts": {
      "type": "boolean",
      "default": true
    },
    "customer_portal_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": []
}